-- This example changes SUPER+SPACE from the launcher to the Omarchy root menu.
-- hl.unbind("SUPER + SPACE")
-- o.bind("SUPER + SPACE", "Omarchy menu", "omarchy-menu toggle root")

-- Disable a default binding without replacing it.
-- hl.unbind("SUPER + SHIFT + B")

-- Replace the default single-window square aspect toggle with one that
-- makes the window 2/3 of the wide (3440x1440) monitor's width instead.
hl.unbind("SUPER + CTRL + BACKSPACE")
o.bind(
	"SUPER + CTRL + BACKSPACE",
	"Toggle single-window square aspect ratio",
	"omarchy-hyprland-window-single-wide-aspect-toggle"
)

