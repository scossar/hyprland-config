-- Search the Obsidian vault with the Omarchy panel.
o.bind("SUPER + CTRL + SHIFT + O", "Obsidian vault search", "omarchy-shell shell toggle scossar.vault-search")

-- Layer-shell panels are not application windows: close the search overlay first.
hl.unbind("SUPER + W")
o.bind("SUPER + W", "Close window or Obsidian search", function()
  for _, layer in ipairs(hl.get_layers()) do
    if layer.namespace == "obsidian-vault-search" and layer.mapped then
      hl.exec_cmd("omarchy-shell shell hide scossar.vault-search")
      return
    end
  end
  hl.dispatch(hl.dsp.window.close())
end)
